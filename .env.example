# أسطى (Usta) — Environment Variables Template
#
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# For production, set these in the Cloudflare Pages dashboard:
#   Settings -> Environment variables

# ─── Public (safe to expose in browser) ─────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=أسطى

# ─── الذكاء الاصطناعي (تقدير الأسعار) ───────────────────────────────
# الترتيب: جيميني أولاً، ثم Claude، ثم نطاق تقريبي إن غاب الاثنان.
#
# GEMINI_API_KEY (الموصى به — مجاني بالكامل، بدون بطاقة دفع):
#   1. افتح https://aistudio.google.com/apikey بحساب Google
#   2. Create API key → انسخه
#   3. أضفه في Cloudflare Pages كمتغيّر Secret باسم GEMINI_API_KEY
GEMINI_API_KEY=

# ANTHROPIC_API_KEY (اختياري — جودة أعلى، مدفوع):
# من https://console.anthropic.com/ — يُستخدم إذا غاب مفتاح جيميني أو فشل.
ANTHROPIC_API_KEY=

# ─── Cloudflare bindings ────────────────────────────────────────────
# These names must match the bindings configured in the Cloudflare Pages
# dashboard (Settings -> Functions).
#   KV binding:  WAITLIST     (namespace: usta-waitlist)
#   D1 binding:  DB           (database: usta-db)

# ─── Admin console (/admin) ─────────────────────────────────────────
# Any long random string (12+ chars). Set as ENCRYPTED in Cloudflare
# Pages env vars. You enter this key on the /admin page to sign in.
ADMIN_KEY=

# ─── Auth (حسابات المستخدمين — هاتف + رمز سري) ────────────────────────
# سر توقيع جلسات الدخول (HMAC-SHA256). أي نص عشوائي طويل (16+ حرفاً).
# ضعه كمتغيّر مشفّر (ENCRYPTED) في Cloudflare Pages — بدونه ترجع
# مسارات التسجيل/الدخول 503 برسالة واضحة وباقي الموقع يخدم عادي.
# تغييره يلغي كل الجلسات المفتوحة (الكل يسجّل دخوله من جديد).
AUTH_SECRET=

# ─── Email (optional confirmations) ─────────────────────────────────
# ملاحظة: البريد اختياري في السوق الليبي — الإيميلات تُرسل فقط لمن أدخل
# بريده. الهاتف/الواتساب هو القناة الأساسية.
# Sign up at https://resend.com/ for a free tier.
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@usta.ly

# ─── Optional: Supabase (Phase 3 auth if we switch off D1) ─────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
